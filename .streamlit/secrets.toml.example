# Streamlit Community Cloud Secrets Template
# Paste these keys into the "Secrets" settings in your Streamlit Community Cloud dashboard.
# NEVER commit real secret values to GitHub.

TOKEN_FACTORY_API_KEY = "your-nebius-token-factory-key"
TOKEN_FACTORY_BASE_URL = "https://api.tokenfactory.nebius.com/v1/"
FAST_MODEL = "nvidia/nemotron-mini-4b-instruct"
STRONG_MODEL = "nvidia/llama-3.1-nemotron-70b-instruct"
VISION_MODEL = "" # Optional vision model for OCR, leave empty to hide OCR in production
TAVILY_API_KEY = "your-tavily-api-key"
MOCK_MODE = "false"
